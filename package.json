{
  "name": "hypotes",
  "version": "0.0.0",
  "description": "Vitest's API and matchers for tests, on Node's test runner",
  "keywords": [
    "expect",
    "fast-check",
    "mock",
    "node:test",
    "test",
    "vitest"
  ],
  "license": "MIT",
  "author": "snovader",
  "homepage": "https://github.com/snovader/hypotes#readme",
  "bugs": {
    "url": "https://github.com/snovader/hypotes/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/snovader/hypotes.git"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24.13.1"
  },
  "exports": {
    ".": {
      "hypotes-dist": "./dist/index.js",
      "default": "./source/index.ts"
    },
    "./fast-check": {
      "hypotes-dist": "./dist/fastCheck.js",
      "default": "./source/fastCheck.ts"
    },
    "./oxlint": {
      "hypotes-dist": "./dist/oxlint/index.js",
      "default": "./source/oxlint/index.ts"
    },
    "./register": {
      "hypotes-dist": "./dist/register.js",
      "default": "./source/register.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./fast-check": {
        "types": "./dist/fastCheck.d.ts",
        "default": "./dist/fastCheck.js"
      },
      "./oxlint": {
        "types": "./dist/oxlint/index.d.ts",
        "default": "./dist/oxlint/index.js"
      },
      "./register": {
        "types": "./dist/register.d.ts",
        "default": "./dist/register.js"
      }
    }
  },
  "scripts": {
    "build": "rm -rf dist && rolldown -c && tsc -p tsconfig.dist.json",
    "format:check": "oxfmt --check",
    "format:write": "oxfmt",
    "lint:check": "oxlint",
    "lint:write": "oxlint --fix",
    "prepack": "yarn build",
    "test": "node --import hypotes/register --test 'test/**/*.test.ts' 'lint/*.test.ts'",
    "test:dist": "yarn build && NODE_OPTIONS=--conditions=hypotes-dist yarn test",
    "test:watch": "node --import hypotes/register --test --watch 'test/**/*.test.ts' 'lint/*.test.ts'",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@vitest/expect": "^5.1.0",
    "@vitest/spy": "^5.1.0",
    "@vitest/utils": "^5.1.0"
  },
  "peerDependencies": {
    "fast-check": "^4.10.2",
    "magic-string": "^1.4.5",
    "oxc-parser": ">=0.159.0 <1",
    "oxlint": "^1.93.0"
  },
  "peerDependenciesMeta": {
    "fast-check": {
      "optional": true
    },
    "magic-string": {
      "optional": true
    },
    "oxc-parser": {
      "optional": true
    },
    "oxlint": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "fast-check": "^4.10.2",
    "magic-string": "^1.4.5",
    "oxc-parser": "^0.159.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2007",
    "rolldown": "^1.3.2",
    "typescript": "^7.0.2"
  }
}
